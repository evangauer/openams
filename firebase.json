{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "apps/api/src/firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "apphosting": [
    {
      "backendId": "openams",
      "rootDir": "/",
      "ignore": [
        "node_modules",
        ".git",
        ".claude",
        "**/.next",
        "**/dist",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "functions"
      ]
    }
  ],
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9099 },
    "firestore": { "host": "127.0.0.1", "port": 8180 },
    "storage": { "host": "127.0.0.1", "port": 9199 },
    "ui": { "enabled": true, "host": "127.0.0.1", "port": 4000 },
    "logging": { "host": "127.0.0.1", "port": 4505 },
    "singleProjectMode": true
  }
}
