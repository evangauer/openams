# OpenAMS web app. Copy to .env.local for development; never commit real values.
# Leave AMS_AUTH_MODE unset for the local evaluation (`npm run dev` at the repo root).

# Hosted sign-in with Firebase Auth email links. Set in BOTH the web and API processes.
AMS_AUTH_MODE=firebase
# The API, reachable only on loopback: http://127.0.0.1:<port>
AMS_API_URL=http://127.0.0.1:4510
# The public origin(s) for the CSRF origin check (comma separated), if behind a proxy.
# AMS_APP_URL is read at runtime and wins; NEXT_PUBLIC_APP_URL is inlined at build time,
# so use AMS_APP_URL when one image serves several deployments (docs/cloud-run.md).
AMS_APP_URL=https://openams.example.test
# NEXT_PUBLIC_APP_URL=https://openams.example.test

# Optional: the Identity Platform tenant this deployment signs people in through (read at
# runtime and handed to the browser by the root layout). Unset: project-level Auth.
# AMS_AUTH_TENANT_ID=agency-a-1x2y3

# Firebase web app configuration (Firebase console > Project settings > Your apps).
# These identify the project; they are not secrets, but use your own project's values.
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Optional: App Check with reCAPTCHA Enterprise. When set, the session exchange sends an
# App Check token; enforce it on the API by passing an AppCheck instance to the router.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Development only: use the Firebase Auth emulator (no email is sent; links are logged).
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9299
