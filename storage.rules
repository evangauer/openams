rules_version = '2';

// Agency documents are served only through the OpenAMS API, which checks the session,
// agency membership, role and the file's recorded SHA-256. Browsers never get direct
// bucket access. Keep this file deny-all.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
