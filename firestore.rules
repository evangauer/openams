rules_version = '2';

// OpenAMS never lets browsers read or write Firestore directly. Every request goes
// through the OpenAMS API, which authenticates the session, derives the agency from
// server-side membership and checks the role before touching data with the Admin SDK
// (which these rules do not apply to). Keep this file deny-all.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
