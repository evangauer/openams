# OpenAMS environment reference. Placeholder values only; never commit real ones.
# The local evaluation (`npm run dev`) needs none of this.

# ---- Hosted sign-in (both processes) ----
AMS_AUTH_MODE=firebase

# ---- API process (apps/api) ----
# Firebase Admin uses Application Default Credentials in production. For the
# emulators, set these instead (the server composition reads them, not identity.ts):
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9299
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8282
# GOOGLE_CLOUD_PROJECT=demo-openams-auth
# The administrator who sets up this instance's agency on first sign-in (comma-separate
# several). Everyone else joins by invitation; there is no open sign-up.
# Who may create agencies: admin (default, one agency set up by AMS_ADMIN_EMAIL) or
# open (anyone can create an agency; for running OpenAMS as a service).
AMS_SIGNUP=admin
AMS_ADMIN_EMAIL=owner@youragency.example
# Optional external access control (docs/external-access.md). Off unless "external".
# AMS_ACCESS_CONTROL=external
# AMS_ACCESS_SERVICE_ACCOUNT=access-controller@your-project-id.iam.gserviceaccount.com
# AMS_ACCESS_URL=https://accounts.example.org/start
# AMS_ACCESS_LINK_SECRET=at-least-32-random-characters
# Open sign-up caps per UTC day (defaults 1000 deployment-wide, 5 per email domain).
# AMS_AGENCY_DAILY_LIMIT=1000
# AMS_AGENCY_DOMAIN_DAILY_LIMIT=5
# Terms whoever creates an agency must accept on its behalf (both or neither; https).
# AMS_TERMS_URL=https://example.org/terms
# AMS_TERMS_VERSION=terms@1.0
# Require a second factor (authenticator app) at every sign-in (docs/hosted-identity.md).
# Turn on TOTP in Identity Platform first.
# AMS_REQUIRE_MFA=1
# Trust a verified session for this many seconds (0-300) instead of checking it on every
# request. Off by default: a revoked session or deactivated member can then keep working
# for up to this long (docs/hosted-identity.md).
# AMS_SESSION_CACHE_SECONDS=60
# Optional email-first text sign-in: enable the Phone provider, then set this in both processes.
# Users verify email once and link their own mobile. Not active while MFA is required.
# Requires project-level Auth: leave AMS_AUTH_TENANT_ID unset.
# AMS_SMS_SIGNIN=1
# Per-agency limits (docs/limits.md): requests a minute, changes a UTC day, stored GiB.
# AMS_AGENCY_REQUESTS_PER_MINUTE=1200
# AMS_AGENCY_WRITES_PER_DAY=20000
# AMS_AGENCY_STORAGE_GB=5
# The public https origin people sign in at. Read at runtime by the API (scheduler and
# status token audiences), the web app and scripts/firebase-start.mjs. NEXT_PUBLIC_APP_URL
# is still accepted (App Hosting sets it); AMS_APP_URL wins when both are set.
AMS_APP_URL=https://openams.example.test
# Optional per-deployment isolation inside one Google Cloud project (docs/cloud-run.md).
# Unset means the default Firestore database, project-level Firebase Auth and the
# project's default bucket.
# AMS_FIRESTORE_DATABASE=agency-a
# AMS_AUTH_TENANT_ID=agency-a-1x2y3
# AMS_STORAGE_BUCKET=your-project-id-openams-agency-a
# Invitations the agency may send per UTC day (default 50).
AMS_INVITATION_DAILY_LIMIT=50
# How long a new invitation stays open, in whole hours from 1 to 720 (default 168).
# AMS_INVITATION_TTL_HOURS=168
# Where the client address is in X-Forwarded-For, counted from the end, so request limits
# before sign-in are kept per client (docs/limits.md). Set it on any public deployment:
# 2 behind a Google Cloud external Application Load Balancer, 1 behind one reverse proxy.
# AMS_CLIENT_ADDRESS_DEPTH=2
# Optional: email invitations and sign-in links in the OpenAMS look, through any SMTP
# service. Unset, invitations are only recorded (the inviter passes the sign-in steps on)
# and Firebase sends its built-in sign-in email.
# AMS_SMTP_URL=smtps://username:password@smtp.example.org:465
# AMS_MAIL_FROM=OpenAMS <no-reply@example.org>
# Sign-in emails sent that way per UTC day before Firebase sends the rest (default 2000).
# AMS_SIGN_IN_EMAIL_DAILY_LIMIT=2000
# Optional: the one service account allowed to read GET /api/internal/status
# (health, version, member counts). Unset or "off" answers 404.
# AMS_STATUS_SERVICE_ACCOUNT=status-reader@your-project-id.iam.gserviceaccount.com

# ---- Web process (apps/web) ----
# See apps/web/.env.example for the full list with comments.
AMS_API_URL=http://127.0.0.1:4510
# AMS_APP_URL and AMS_AUTH_TENANT_ID above are read by the web process too.
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9299
